<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/MaterialsFragment">

    <fragment
        android:id="@+id/MaterialsFragment"
        android:name="ir.kitgroup.formulaNew.fragment.MaterialsFragment"
        android:label="@string/label_material"
        tools:layout="@layout/fragment_materials">
        <action
            android:id="@+id/action_MaterialsFragment_to_changeLogFragment"
            app:destination="@id/changeLogFragment" />
    </fragment>
    <fragment
        android:id="@+id/PackagingFragment"
        android:name="ir.kitgroup.formulaNew.fragment.PackagingFragment"
        android:label="@string/label_packaging"
        tools:layout="@layout/fragment_packaging">

        <action
            android:id="@+id/action_PackagingFragment_to_packagingDetailsFragment"
            app:destination="@id/packagingDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/ProductsFragment"
        android:name="ir.kitgroup.formulaNew.fragment.ProductsFragment"
        android:label="@string/label_product"
        tools:layout="@layout/fragment_products">

        <action
            android:id="@+id/actionProductsFragmentToProductDetailsFragment"
            app:destination="@id/productDetailsFragment" />
        <action
            android:id="@+id/action_ProductsFragment_to_changeLogFragment"
            app:destination="@id/changeLogFragment" />
        <action
            android:id="@+id/action_ProductsFragment_to_productUsageFragment"
            app:destination="@id/productUsageFragment" />

    </fragment>

    <fragment
        android:id="@+id/productDetailsFragment"
        android:name="ir.kitgroup.formulaNew.fragment.ProductDetailsFragment"
        android:label="@layout/fragment_product_details">

        <argument
            android:name="productId"
            app:argType="integer" />
        <argument
            android:name="productName"
            app:argType="string" />
        <argument
            android:name="productDate"
            app:argType="long" />
        <argument
            android:name="productDescription"
            app:argType="string" />
        <action
            android:id="@+id/actionProductDetailsFragmentSelf"
            app:destination="@id/productDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/changeLogFragment"
        android:name="ir.kitgroup.formulaNew.fragment.ChangeLogFragment"
        android:label="ChangeLogFragment">
        <argument
            android:name="materialId"
            app:argType="integer" />

        <argument
            android:name="changeType"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/productUsageFragment"
        android:name="ir.kitgroup.formulaNew.fragment.ProductUsageFragment"
        android:label="ProductUsageFragment">

        <argument
            android:name="productId"
            app:argType="integer" />
        <argument
            android:name="productName"
            app:argType="string" />
        <argument
            android:name="productDate"
            app:argType="long" />
        <argument
            android:name="productDescription"
            app:argType="string" />
        <action
            android:id="@+id/action_productUsageFragment_to_productUsageDetailsFragment"
            app:destination="@id/productUsageDetailsFragment" />

    </fragment>
    <fragment
        android:id="@+id/productUsageDetailsFragment"
        android:name="ir.kitgroup.formulaNew.fragment.ProductUsageDetailsFragment"
        android:label="ProductUsageDetailsFragment">
        <argument
            android:name="type"
            app:argType="integer" />
        <argument
            android:name="id"
            app:argType="long" />
        <argument
            android:name="productId"
            app:argType="integer" />
           <argument
            android:name="productName"
            app:argType="string" />
        <argument
            android:name="productDate"
            app:argType="long" />
        <argument
            android:name="formattedQty"
            app:argType="string" />
        <argument
            android:name="totalPrice"
            app:argType="string" />

        <action
            android:id="@+id/actionProductUsageDetailsFragmentSelf"
            app:destination="@id/productUsageDetailsFragment" />
        <action
            android:id="@+id/action_productUsageDetailsFragment_to_packagingUsageDetailsFragment"
            app:destination="@id/packagingUsageDetailsFragment" />
    </fragment>
    <fragment
        android:id="@+id/packagingDetailsFragment"
        android:name="ir.kitgroup.formulaNew.fragment.PackagingDetailsFragment"
        android:label="PackagingDetailsFragment">

        <argument
            android:name="packageId"
            app:argType="integer" />
        <argument
            android:name="packageName"
            app:argType="string" />
        <argument
            android:name="packageDate"
            app:argType="long" />
        <argument
            android:name="packageDescription"
            app:argType="string" />
        <argument
            android:name="packageWeight"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/packagingUsageDetailsFragment"
        android:name="ir.kitgroup.formulaNew.fragment.PackagingUsageDetailsFragment"
        android:label="PackagingUsageDetailsFragment">
        <argument
            android:name="packageId"
            app:argType="integer" />
        <argument
            android:name="id"
            app:argType="long" />
        <argument
            android:name="packageName"
            app:argType="string" />
        <argument
            android:name="packageDate"
            app:argType="long" />
        <argument
            android:name="formattedQty"
            app:argType="string" />
        <argument
            android:name="packagePrice"
            app:argType="string" />
    </fragment>
</navigation>
